{% extends 'base.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}
<style>
.card-block {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    border: 1px solid #ddd;
    padding: 1rem;
    border-radius: .25rem;
}
.card-block img {
    width: 48px;
    height: 48px;
    margin-right: 1rem;
}
.card-block .content {
    flex-grow: 1;
}
.card-block h4 {
    margin-top: 0;
    margin-bottom: .25rem;
    font-size: 1.1rem;
}
.card-block p {
    margin-bottom: .5rem;
    color: #6c757d;
    font-size: 0.9rem;
}
.card-block .links a {
    margin-right: 0.75rem;
    font-size: 0.9rem;
}
</style>

<div class="row">
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/hardware.png" alt="Hardware">
            <div class="content">
                <h4>Hardware</h4>
                <p>Manage your H/W items: PCs, Switches, Phones, etc.</p>
                <div class="links">
                    <a href="/items">Find</a>
                    <a href="/items/create">Add</a>
                    <a href="/admin/item-types">Item Types</a>
                    <a href="/admin/status-types">Status Types</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/software.png" alt="Software">
            <div class="content">
                <h4>Software</h4>
                <p>Manage your software.</p>
                <div class="links">
                    <a href="/software">Find</a>
                    <a href="/software/create">Add</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/document.png" alt="Invoices">
            <div class="content">
                <h4>Invoices</h4>
                <p>Manage your Invoices.</p>
                <div class="links">
                    <a href="/invoices">Find</a>
                    <a href="/invoices/create">Add</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/pie.png" alt="Reports">
            <div class="content">
                <h4>Reports</h4>
                <p>View Reports.</p>
                <div class="links">
                    <a href="/reports">Reports</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/contract.png" alt="Contracts">
            <div class="content">
                <h4>Contracts</h4>
                <p>Manage your contracts: Support, Licenses, Leases, etc.</p>
                <div class="links">
                    <a href="/contracts">Find</a>
                    <a href="/contracts/create">Add</a>
                    <a href="/admin/contract-types">Contract Types</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/company.png" alt="Agents">
            <div class="content">
                <h4>Agents</h4>
                <p>Manage Agents: H/W & S/W Manufacturers & Vendors, Buyers, Contractors.</p>
                <div class="links">
                    <a href="/agents">Find</a>
                    <a href="/agents/create">Add</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/view_tree.png" alt="Browse">
            <div class="content">
                <h4>Browse</h4>
                <p>Tree Explorer: View items by type, by user, by agent.</p>
                <div class="links">
                    <a href="/locations/tree">Tree Explorer</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/rack1.png" alt="Racks">
            <div class="content">
                <h4>Racks</h4>
                <p>Add/View Racks.</p>
                <div class="links">
                    <a href="/racks">Find</a>
                    <a href="/racks/create">Add</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/location.png" alt="Locations">
            <div class="content">
                <h4>Locations</h4>
                <p>Manage item locations.</p>
                <div class="links">
                    <a href="/locations">Find</a>
                    <a href="/locations/create">Add</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/labels.png" alt="Labels">
            <div class="content">
                <h4>Labels</h4>
                <p>Select and print labels for your items.</p>
                <div class="links">
                    <a href="/admin/labels">Print Labels</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-block">
            <img src="/home-icons/settings.png" alt="Settings">
            <div class="content">
                <h4>Settings</h4>
                <p>Manage various parameters: Users, Tags, Dates, Currency,...</p>
                <div class="links">
                    <a href="/users">Users</a>
                    <a href="/admin/tags">Tags</a>
                    <a href="/admin/settings">Settings</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-clock-history me-2"></i>Recent Changes
                </h5>
            </div>
            <div class="card-body">
                {% if recent_changes is not empty %}
                    <ul class="list-group list-group-flush">
                        {% for change in recent_changes %}
                            <li class="list-group-item">
                                <a href="/{{ change.type }}s/{{ change.id }}" class="text-decoration-none">
                                    <strong>{{ change.name }}</strong>
                                </a>
                                <small class="text-muted d-block">{{ change.type|capitalize }} - {{ change.updated_at|date("Y-m-d H:i") }}</small>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-2">No recent changes found</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
