{% extends "base.twig" %}

{% block title %}
    {% if mode == 'create' %}
        Create New Agent
    {% else %}
        Edit Agent: {{ agent.title }}
    {% endif %}
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const contactsContainer = document.getElementById('contacts-container');
        const addContactBtn = document.getElementById('add-contact');
        const contactsJsonInput = document.getElementById('contacts-json');

        let contacts = [];

        try {
            contacts = JSON.parse('{{ agent.contacts|default("[]")|raw }}');
        } catch (e) {
            contacts = [];
        }

        function renderContacts() {
            contactsContainer.innerHTML = '';
            contacts.forEach((contact, index) => {
                const contactEl = document.createElement('div');
                contactEl.classList.add('contact-person', 'mb-3', 'p-3', 'border', 'rounded');
                contactEl.innerHTML = `
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-2">
                                <label class="form-label small">Name</label>
                                <input type="text" class="form-control form-control-sm" data-index="${index}" data-field="name" value="${contact.name || ''}">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-2">
                                <label class="form-label small">Phone</label>
                                <input type="text" class="form-control form-control-sm" data-index="${index}" data-field="phone" value="${contact.phone || ''}">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-2">
                                <label class="form-label small">Email</label>
                                <input type="email" class="form-control form-control-sm" data-index="${index}" data-field="email" value="${contact.email || ''}">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="form-label small">Role</label>
                                <input type="text" class="form-control form-control-sm" data-index="${index}" data-field="role" value="${contact.role || ''}">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="form-label small">Comments</label>
                                <input type="text" class="form-control form-control-sm" data-index="${index}" data-field="comments" value="${contact.comments || ''}">
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-contact" data-index="${index}">Remove</button>
                `;
                contactsContainer.appendChild(contactEl);
            });
            updateJsonInput();
        }

        function updateJsonInput() {
            contactsJsonInput.value = JSON.stringify(contacts);
        }

        addContactBtn.addEventListener('click', () => {
            contacts.push({});
            renderContacts();
        });

        contactsContainer.addEventListener('input', (e) => {
            const index = e.target.dataset.index;
            const field = e.target.dataset.field;
            contacts[index][field] = e.target.value;
            updateJsonInput();
        });

        contactsContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-contact')) {
                const index = e.target.dataset.index;
                contacts.splice(index, 1);
                renderContacts();
            }
        });

        renderContacts();
    });
</script>
{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/agents">Agents</a></li>
            {% if mode == 'create' %}
                <li class="breadcrumb-item active">Create New Agent</li>
            {% else %}
                <li class="breadcrumb-item"><a href="/agents/{{ agent.id }}/edit">{{ agent.title }}</a></li>
                <li class="breadcrumb-item active">Edit</li>
            {% endif %}
        </ol>
    </nav>

    <div class="btn-group">
        <a href="/agents" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Agents
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    {% if mode == 'create' %}
                        <i class="bi bi-plus-lg me-2"></i>Create Agent
                    {% else %}
                        <i class="bi bi-pencil me-2"></i>Edit Agent
                    {% endif %}
                </h5>
            </div>
            <div class="card-body">
                <form method="post" action="{% if mode == 'create' %}/agents{% else %}/agents/{{ agent.id }}{% endif %}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                    <div class="row mb-1 py-1">
                        <label for="name" class="col-md-3 col-form-label text-end">Agent Name <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   id="name"
                                   name="name"
                                   value="{{ agent.name|default('') }}"
                                   required>
                        </div>
                    </div>

                    <div class="row mb-1 py-1">
                        <label for="agent_types" class="col-md-3 col-form-label text-end">Agent Types</label>
                        <div class="col-md-9">
                            <div class="row">
                                {% set agent_type_ids = (agent_types) ? agent_types|map(a => a.id) : [] %}
                                {% for agent_type in available_agent_types %}
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="agent_type_{{ agent_type.id }}"
                                               name="agent_types[]"
                                               value="{{ agent_type.id }}"
                                               {% if agent_type.id in agent_type_ids %}checked{% endif %}>
                                        <label class="form-check-label" for="agent_type_{{ agent_type.id }}">
                                            <span class="badge bg-{{ agent_type.badge_color|default('secondary') }} me-2" style="display: inline-block; width: 12px; height: 12px; padding: 0; position: relative; top: 1px;"></span>
                                            {{ agent_type.name }}
                                        </label>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <div class="row mb-1 py-1">
                        <label for="contactinfo" class="col-md-3 col-form-label text-end">Contact Information</label>
                        <div class="col-md-9">
                            <textarea class="form-control form-control-sm"
                                      id="contactinfo"
                                      name="contactinfo"
                                      rows="2">{{ agent.contact_info|default('') }}</textarea>
                        </div>
                    </div>

                    <div class="row mb-1 py-1">
                        <label for="contacts" class="col-md-3 col-form-label text-end">Contact Persons</label>
                        <div class="col-md-9">
                            <div id="contacts-container"></div>
                            <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="add-contact">
                                <i class="bi bi-plus-lg me-1"></i>Add Contact Person
                            </button>
                            <input type="hidden" name="contacts" id="contacts-json">
                        </div>
                    </div>

                    <div class="row mb-1 py-1">
                        <label for="urls" class="col-md-3 col-form-label text-end">URLs</label>
                        <div class="col-md-9">
                            <textarea class="form-control form-control-sm"
                                      id="urls"
                                      name="urls"
                                      rows="3">{{ agent.urls|default('') }}</textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        {% if mode == 'create' %}
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Create Agent
                            </button>
                        {% else %}
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Update Agent
                            </button>
                        {% endif %}
                        <a href="/agents" class="btn btn-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {% if mode == 'edit' and agent %}
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle me-1"></i>Agent Information
                </h6>
            </div>
            <div class="card-body">
                <dl class="row small">
                    <dt class="col-sm-4">ID:</dt>
                    <dd class="col-sm-8">{{ agent.id }}</dd>

                    <dt class="col-sm-4">Types:</dt>
                    <dd class="col-sm-8">
                        {% if agent_types is not empty %}
                            {% for type in agent_types %}
                                <span class="badge bg-info me-1">{{ type.name }}</span>
                            {% endfor %}
                        {% else %}
                            <span class="text-muted">No types assigned</span>
                        {% endif %}
                    </dd>

                    <dt class="col-sm-4">Legacy Type:</dt>
                    <dd class="col-sm-8">
                        {% if agent.type %}
                            <code>{{ agent.type }}</code>
                        {% else %}
                            <span class="text-muted">None</span>
                        {% endif %}
                    </dd>
                </dl>
            </div>
        </div>

        {% if relationships is defined %}
        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-link-45deg me-1"></i>Relationships
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong class="small text-muted d-block mb-1">
                        <i class="bi bi-laptop me-1"></i>Items ({{ relationships.items|length }})
                    </strong>
                    {% if relationships.items|length > 0 %}
                    <div class="small" style="max-height: 300px; overflow-y: auto;">
                        {% for item in relationships.items %}
                            <a href="/items/{{ item.id }}" class="d-block text-decoration-none py-1">
                                #{{ item.id }} {{ item.label|default(item.function)|default('N/A') }}
                            </a>
                        {% endfor %}
                    </div>
                    {% else %}
                    <span class="small text-muted">None</span>
                    {% endif %}
                </div>

                <div class="mb-3">
                    <strong class="small text-muted d-block mb-1">
                        <i class="bi bi-code-square me-1"></i>Software ({{ relationships.software|length }})
                    </strong>
                    {% if relationships.software|length > 0 %}
                    <div class="small" style="max-height: 300px; overflow-y: auto;">
                        {% for software in relationships.software %}
                            <a href="/software/{{ software.id }}" class="d-block text-decoration-none py-1">
                                #{{ software.id }} {{ software.title|default('N/A') }}{% if software.version %} v{{ software.version }}{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                    {% else %}
                    <span class="small text-muted">None</span>
                    {% endif %}
                </div>

                <div class="mb-3">
                    <strong class="small text-muted d-block mb-1">
                        <i class="bi bi-receipt me-1"></i>Invoices as Vendor ({{ relationships.invoices_vendor|length }})
                    </strong>
                    {% if relationships.invoices_vendor|length > 0 %}
                    <div class="small" style="max-height: 300px; overflow-y: auto;">
                        {% for invoice in relationships.invoices_vendor %}
                            <a href="/invoices/{{ invoice.id }}" class="d-block text-decoration-none py-1">
                                #{{ invoice.id }}{% if invoice.totalcost %} - ${{ invoice.totalcost|number_format(2) }}{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                    {% else %}
                    <span class="small text-muted">None</span>
                    {% endif %}
                </div>

                <div class="mb-3">
                    <strong class="small text-muted d-block mb-1">
                        <i class="bi bi-cart me-1"></i>Invoices as Buyer ({{ relationships.invoices_buyer|length }})
                    </strong>
                    {% if relationships.invoices_buyer|length > 0 %}
                    <div class="small" style="max-height: 300px; overflow-y: auto;">
                        {% for invoice in relationships.invoices_buyer %}
                            <a href="/invoices/{{ invoice.id }}" class="d-block text-decoration-none py-1">
                                #{{ invoice.id }}{% if invoice.totalcost %} - ${{ invoice.totalcost|number_format(2) }}{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                    {% else %}
                    <span class="small text-muted">None</span>
                    {% endif %}
                </div>

                <div class="mb-3">
                    <strong class="small text-muted d-block mb-1">
                        <i class="bi bi-file-text me-1"></i>Contracts ({{ relationships.contracts|length }})
                    </strong>
                    {% if relationships.contracts|length > 0 %}
                    <div class="small" style="max-height: 300px; overflow-y: auto;">
                        {% for contract in relationships.contracts %}
                            <a href="/contracts/{{ contract.id }}" class="d-block text-decoration-none py-1">
                                #{{ contract.id }} {{ contract.title|default('N/A') }}
                            </a>
                        {% endfor %}
                    </div>
                    {% else %}
                    <span class="small text-muted">None</span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}

        {% if user and user.isAdmin() %}
        <div class="card mt-3">
            <div class="card-header bg-danger text-white">
                <h6 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>Danger Zone
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">
                    Delete this agent permanently. This action cannot be undone.
                </p>
                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        onclick="confirmDelete()">
                    <i class="bi bi-trash me-1"></i>Delete Agent
                </button>
            </div>
        </div>
        {% endif %}
    </div>
    {% endif %}
</div>

{% if mode == 'edit' and agent %}
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the agent "{{ agent.title }}"?</p>
                <p class="text-warning small">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="/agents/{{ agent.id }}" style="display: inline;">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="_METHOD" value="DELETE">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function confirmDelete() {
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>
{% endif %}
{% endblock %}