{% extends "base.twig" %}

{% block title %}
    {% if mode == 'create' %}
        Create New Rack
    {% elseif mode == 'edit' %}
        Edit Rack: {{ rack.display_name }}
    {% else %}
        {{ rack.display_name }}
    {% endif %}
{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/racks">Racks</a></li>
        {% if mode == 'create' %}
            <li class="breadcrumb-item active">Create New Rack</li>
        {% else %}
            <li class="breadcrumb-item active">{{ rack.display_name }}</li>
        {% endif %}
    </ol>
</nav>

{% if mode == 'edit' or mode == 'create' %}
    <!-- EDIT/CREATE MODE -->
    <div class="row">
        <div class="{% if mode == 'edit' and rack.size_units %}col-lg-5{% else %}col-lg-10 mx-auto{% endif %}">
            <div class="card">
                <div class="card-header py-1 px-2">
                    <h6 class="mb-0 small">
                        {% if mode == 'create' %}
                            <i class="bi bi-plus-circle me-2"></i>Create New Rack
                        {% else %}
                            <i class="bi bi-pencil me-2"></i>Edit Rack: {{ rack.display_name }}
                        {% endif %}
                    </h6>
                </div>
                <div class="card-body p-2">
                    <form method="POST" action="{% if mode == 'create' %}/racks{% else %}/racks/{{ rack.id }}{% endif %}">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        {% if mode == 'edit' %}
                        <input type="hidden" name="_METHOD" value="PUT">
                        {% endif %}

                        {% if mode == 'edit' %}
                        <div class="row mb-1">
                            <label class="col-sm-4 col-form-label col-form-label-sm text-end">Rack ID</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control form-control-sm" value="#{{ rack.id }}" readonly>
                            </div>
                        </div>
                        {% endif %}

                        <div class="row mb-1">
                            <label for="label" class="col-sm-4 col-form-label col-form-label-sm text-end">Rack Label <span class="text-danger">*</span></label>
                            <div class="col-sm-8">
                                <input type="text"
                                       class="form-control form-control-sm{% if errors.label %} is-invalid{% endif %}"
                                       id="label"
                                       name="label"
                                       value="{{ old.label|default(rack.label|default('')) }}"
                                       maxlength="100"
                                       required>
                                {% if errors.label %}
                                <div class="invalid-feedback">{{ errors.label }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mb-1">
                            <label for="model" class="col-sm-4 col-form-label col-form-label-sm text-end">Model</label>
                            <div class="col-sm-8">
                                <input type="text"
                                       class="form-control form-control-sm{% if errors.model %} is-invalid{% endif %}"
                                       id="model"
                                       name="model"
                                       value="{{ old.model|default(rack.model|default('')) }}"
                                       maxlength="100">
                                {% if errors.model %}
                                <div class="invalid-feedback">{{ errors.model }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mb-1">
                            <label for="location_id" class="col-sm-4 col-form-label col-form-label-sm text-end">Location <span class="text-danger">*</span></label>
                            <div class="col-sm-8">
                                <select class="form-select form-select-sm{% if errors.location_id %} is-invalid{% endif %}"
                                        id="location_id"
                                        name="location_id"
                                        required>
                                    <option value="">Select location...</option>
                                    {% for location in form_options.locations %}
                                    <option value="{{ location.id }}"
                                            {% if (old.location_id|default(rack.location_id|default(''))) == location.id %}selected{% endif %}>
                                        {{ location.name }}
                                        {% if location.floor %} ({{ location.floor }}){% endif %}
                                    </option>
                                    {% endfor %}
                                </select>
                                {% if errors.location_id %}
                                <div class="invalid-feedback">{{ errors.location_id }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mb-1">
                            <label for="location_area_id" class="col-sm-4 col-form-label col-form-label-sm text-end">Area</label>
                            <div class="col-sm-8">
                                <select class="form-select form-select-sm{% if errors.location_area_id %} is-invalid{% endif %}"
                                        id="location_area_id"
                                        name="location_area_id">
                                    <option value="">No specific area</option>
                                    {% for area in form_options.location_areas %}
                                    <option value="{{ area.id }}"
                                            {% if (old.location_area_id|default(rack.location_area_id|default(''))) == area.id %}selected{% endif %}
                                            data-location="{{ area.location_id }}">
                                        {{ area.name }}
                                    </option>
                                    {% endfor %}
                                </select>
                                {% if errors.location_area_id %}
                                <div class="invalid-feedback">{{ errors.location_area_id }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mb-1">
                            <label for="size_units" class="col-sm-4 col-form-label col-form-label-sm text-end">Size (U) <span class="text-danger">*</span></label>
                            <div class="col-sm-8">
                                <select class="form-select form-select-sm{% if errors.size_units %} is-invalid{% endif %}"
                                        id="size_units"
                                        name="size_units"
                                        required>
                                    <option value="">Select...</option>
                                    {% set current_size_units = old.size_units|default(rack.size_units|default('')) %}
                                    <option value="4" {% if current_size_units == 4 %}selected{% endif %}>4U</option>
                                    <option value="6" {% if current_size_units == 6 %}selected{% endif %}>6U</option>
                                    <option value="9" {% if current_size_units == 9 %}selected{% endif %}>9U</option>
                                    <option value="12" {% if current_size_units == 12 %}selected{% endif %}>12U</option>
                                    <option value="18" {% if current_size_units == 18 %}selected{% endif %}>18U</option>
                                    <option value="24" {% if current_size_units == 24 %}selected{% endif %}>24U</option>
                                    <option value="42" {% if current_size_units == 42 %}selected{% endif %}>42U</option>
                                    <option value="45" {% if current_size_units == 45 %}selected{% endif %}>45U</option>
                                    <option value="48" {% if current_size_units == 48 %}selected{% endif %}>48U</option>
                                    {% if current_size_units and current_size_units not in [4, 6, 9, 12, 18, 24, 42, 45, 48] %}
                                    <option value="{{ current_size_units }}" selected>{{ current_size_units }}U</option>
                                    {% endif %}
                                    <option value="custom">Custom...</option>
                                </select>
                                {% if errors.size_units %}
                                <div class="invalid-feedback">{{ errors.size_units }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mb-2" id="custom-size-field" style="display: none;">
                            <label for="custom_size_units" class="col-sm-4 col-form-label col-form-label-sm text-end">Custom (U)</label>
                            <div class="col-sm-8">
                                <input type="number"
                                       class="form-control form-control-sm"
                                       id="custom_size_units"
                                       name="custom_size_units"
                                       min="1"
                                       max="100">
                            </div>
                        </div>

                        <div class="row mb-1">
                            <label for="depth_mm" class="col-sm-4 col-form-label col-form-label-sm text-end">Depth (mm)</label>
                            <div class="col-sm-8">
                                <select class="form-select form-select-sm{% if errors.depth_mm %} is-invalid{% endif %}"
                                        id="depth_mm"
                                        name="depth_mm">
                                    <option value="">Select...</option>
                                    {% set current_depth_mm = old.depth_mm|default(rack.depth_mm|default('')) %}
                                    <option value="600" {% if current_depth_mm == 600 %}selected{% endif %}>600mm</option>
                                    <option value="800" {% if current_depth_mm == 800 %}selected{% endif %}>800mm</option>
                                    <option value="900" {% if current_depth_mm == 900 %}selected{% endif %}>900mm</option>
                                    <option value="1000" {% if current_depth_mm == 1000 %}selected{% endif %}>1000mm</option>
                                    <option value="1100" {% if current_depth_mm == 1100 %}selected{% endif %}>1100mm</option>
                                    <option value="1200" {% if current_depth_mm == 1200 %}selected{% endif %}>1200mm</option>
                                    {% if current_depth_mm and current_depth_mm not in [600, 800, 900, 1000, 1100, 1200] %}
                                    <option value="{{ current_depth_mm }}" selected>{{ current_depth_mm }}mm</option>
                                    {% endif %}
                                </select>
                                {% if errors.depth_mm %}
                                <div class="invalid-feedback">{{ errors.depth_mm }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mb-1">
                            <label class="col-sm-4 col-form-label col-form-label-sm text-end">U Numbering</label>
                            <div class="col-sm-8">
                                <div class="form-check">
                                    <input class="form-check-input{% if errors.reverse_numbering %} is-invalid{% endif %}"
                                           type="checkbox"
                                           id="reverse_numbering"
                                           name="reverse_numbering"
                                           value="1"
                                           {% if (old.reverse_numbering|default(rack.reverse_numbering|default(''))) == 1 %}checked{% endif %}>
                                    <label class="form-check-label" for="reverse_numbering">
                                        Reverse
                                    </label>
                                    {% if errors.reverse_numbering %}
                                    <div class="invalid-feedback">{{ errors.reverse_numbering }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {% if mode == 'edit' %}
                        <div class="row mb-1">
                            <label class="col-sm-4 col-form-label col-form-label-sm text-end">Items</label>
                            <div class="col-sm-8">
                                <span class="badge bg-info">{{ rack.items|length }}</span>
                            </div>
                        </div>
                        {% endif %}

                        <div class="row mb-1">
                            <label for="comments" class="col-sm-4 col-form-label col-form-label-sm text-end">Comments</label>
                            <div class="col-sm-8">
                                <textarea class="form-control form-control-sm{% if errors.comments %} is-invalid{% endif %}"
                                          id="comments"
                                          name="comments"
                                          rows="2">{{ old.comments|default(rack.comments|default('')) }}</textarea>
                                {% if errors.comments %}
                                <div class="invalid-feedback">{{ errors.comments }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <hr class="my-2">

                        <div class="d-flex justify-content-between">
                            <div>
                                {% if mode == 'create' %}
                                <a href="/racks" class="btn btn-secondary">
                                    <i class="bi bi-x-lg me-1"></i>Cancel
                                </a>
                                {% else %}
                                <a href="/racks/{{ rack.id }}" class="btn btn-secondary">
                                    <i class="bi bi-x-lg me-1"></i>Cancel
                                </a>
                                {% endif %}
                            </div>
                            <div>
                                {% if mode == 'edit' and user and user.isAdmin() and rack.items|length == 0 %}
                                <button type="button"
                                        class="btn btn-outline-danger me-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal">
                                    <i class="bi bi-trash me-1"></i>Delete Rack
                                </button>
                                {% endif %}
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>{% if mode == 'create' %}Create Rack{% else %}Update Rack{% endif %}
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {% if mode == 'edit' and rack.size_units %}
        <!-- Rack Visualization - Side View -->
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header py-1 px-2">
                    <h6 class="mb-0 small">Rack Layout</h6>
                </div>
                <div class="card-body p-2">
                    <div class="rack-visualization">
                        <div class="rack-frame-side">
                            <!-- Column headers -->
                            <div class="rack-header">
                                <div class="unit-number-col"></div>
                                <div class="depth-col">Front</div>
                                <div class="depth-col">Middle</div>
                                <div class="depth-col">Back</div>
                            </div>

                            <!-- Rack Units -->
                            {% set rack_units = rack.size_units %}
                            {% for u in 1..rack_units %}
                                {% set unit_number = rack.revnums ? (rack_units - u + 1) : u %}

                                {# Find items at this position #}
                                {% set items_at_u = [] %}
                                {% for item in rack.items %}
                                    {% if item.rackposition == unit_number %}
                                        {% set items_at_u = items_at_u|merge([item]) %}
                                    {% endif %}
                                {% endfor %}

                                <div class="rack-unit-row" data-unit="{{ unit_number }}">
                                    <div class="unit-number">{{ unit_number }}</div>

                                    {# Front column (depth 4 or 6 or 7) #}
                                    <div class="depth-slot">
                                        {% for item in items_at_u %}
                                            {% if item.rackposdepth in [4, 6, 7] %}
                                                {% set item_title = '#' ~ item.id ~ ' ' ~ (item.manufacturer_name ? item.manufacturer_name ~ ' ' : '') ~ (item.model ? item.model : item.label|default(item.function)|default('N/A')) %}
                                                <a href="/items/{{ item.id }}/edit" class="item-block {% if item.status != 0 %}item-inactive{% endif %}" title="{{ item_title }}">
                                                    <i class="bi bi-laptop"></i>
                                                    <span class="item-label">{{ item_title }}</span>
                                                </a>
                                            {% endif %}
                                        {% endfor %}
                                    </div>

                                    {# Middle column (depth 2 or 6 or 3 or 7) #}
                                    <div class="depth-slot">
                                        {% for item in items_at_u %}
                                            {% if item.rackposdepth in [2, 6, 3, 7] %}
                                                {% set item_title = '#' ~ item.id ~ ' ' ~ (item.manufacturer_name ? item.manufacturer_name ~ ' ' : '') ~ (item.model ? item.model : item.label|default(item.function)|default('N/A')) %}
                                                <a href="/items/{{ item.id }}/edit" class="item-block {% if item.status != 0 %}item-inactive{% endif %}" title="{{ item_title }}">
                                                    <i class="bi bi-laptop"></i>
                                                    <span class="item-label">{{ item_title }}</span>
                                                </a>
                                            {% endif %}
                                        {% endfor %}
                                    </div>

                                    {# Back column (depth 1 or 3 or 7) #}
                                    <div class="depth-slot">
                                        {% for item in items_at_u %}
                                            {% if item.rackposdepth in [1, 3, 7] %}
                                                {% set item_title = '#' ~ item.id ~ ' ' ~ (item.manufacturer_name ? item.manufacturer_name ~ ' ' : '') ~ (item.model ? item.model : item.label|default(item.function)|default('N/A')) %}
                                                <a href="/items/{{ item.id }}/edit" class="item-block {% if item.status != 0 %}item-inactive{% endif %}" title="{{ item_title }}">
                                                    <i class="bi bi-laptop"></i>
                                                    <span class="item-label">{{ item_title }}</span>
                                                </a>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
{% endif %}

<!-- Action Modals -->
{% if mode == 'edit' and user and user.isAdmin() and rack.items|length == 0 %}
    <!-- Delete Modal for Edit Mode -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this rack?</p>
                    <div class="alert alert-warning">
                        <strong>{{ rack.display_name }}</strong>
                        {% if rack.location %}<br>Location: {{ rack.location.name }}{% endif %}
                        {% if rack.size_units %}<br>Size: {{ rack.size_units }}U{% endif %}
                    </div>
                    <p class="text-danger mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        This action cannot be undone. The rack configuration will be permanently removed.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form method="POST" action="/racks/{{ rack.id }}/delete" class="d-inline">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete Rack
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endif %}

<!-- Rack Visualization Styles -->
{% if mode == 'edit' or mode == 'create' %}
<style>
.rack-visualization {
    background: transparent;
    padding: 0;
}

.rack-frame-side {
    background: white;
    border-collapse: collapse;
    border-spacing: 0;
    width: 100%;
    max-width: 600px;
}

.rack-header {
    display: grid;
    grid-template-columns: 30px 3fr 1fr 1fr;
    gap: 0;
    margin-bottom: 0;
    font-weight: bold;
    color: #fff;
    font-size: 10px;
    text-align: center;
    padding: 0;
    line-height: 1.1;
}

.unit-number-col {
    background: transparent;
}

.depth-col {
    background: #888;
    padding: 0 2px;
    border: 0.5px solid #eee;
    border-radius: 0;
    font-size: 11px;
}

.rack-unit-row {
    display: grid;
    grid-template-columns: 30px 3fr 1fr 1fr;
    gap: 0;
    margin-bottom: 0;
}

.unit-number {
    background: white;
    color: #000;
    font-size: 10px;
    font-weight: normal;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0.5px solid #afafaf;
    border-radius: 0;
    min-height: 12px;
    padding: 0;
    line-height: 1.1;
}

.depth-slot {
    background: #fafafa;
    border: 0.5px solid #afafaf;
    border-radius: 0;
    min-height: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2px;
    overflow: hidden;
    min-width: 60px;
    line-height: 1.1;
}

.depth-slot:has(.item-block) {
    background: #CBE98B;
}

.depth-slot:has(.item-inactive) {
    background: #fafafa;
}

.item-block {
    color: #000;
    text-decoration: none;
    font-size: 10px;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 2px;
    white-space: nowrap;
    overflow: hidden;
    width: 100%;
    line-height: 1.1;
}

.item-block.item-inactive {
    color: #666;
    font-weight: normal;
}

.item-block i {
    font-size: 10px;
    flex-shrink: 0;
}

.item-block:hover {
    opacity: 0.8;
    text-decoration: underline;
}

.item-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.rack-unit-row:hover {
    background: rgba(255, 255, 255, 0.05);
}
</style>
{% endif %}
{% endblock %}

{% block scripts %}
{% if mode == 'edit' or mode == 'create' %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-focus on label field
    document.getElementById('label').focus();

    // Handle custom size selection
    const sizeUnitsSelect = document.getElementById("size_units");
    const customSizeField = document.getElementById('custom-size-field');
    const customUsizeInput = document.getElementById('custom_size_units');

    sizeUnitsSelect.addEventListener('change', function() {
        if (this.value === 'custom') {
            customSizeField.style.display = 'block';
            customUsizeInput.required = true;
            customUsizeInput.focus();
        } else {
            customSizeField.style.display = 'none';
            customUsizeInput.required = false;
            customUsizeInput.value = '';
        }
    });

    // Initialize custom field if needed
    if (sizeUnitsSelect.value === 'custom') {
        customSizeField.style.display = 'block';
        customUsizeInput.required = true;
    }

    // Filter location areas based on selected location
    const locationSelect = document.getElementById('locationid');
    const areaSelect = document.getElementById('locareaid');

    function filterAreas() {
        const selectedLocationId = locationSelect.value;
        const areaOptions = areaSelect.querySelectorAll('option[data-location]');

        // Show/hide area options based on selected location
        areaOptions.forEach(function(option) {
            if (option.dataset.location === selectedLocationId) {
                option.style.display = 'block';
            } else {
                option.style.display = 'none';
            }
        });

        // Reset area selection if it's not valid for the current location
        const currentAreaOption = areaSelect.querySelector(`option[value="${areaSelect.value}"]`);
        if (currentAreaOption && currentAreaOption.dataset.location !== selectedLocationId && selectedLocationId) {
            areaSelect.value = '';
        }

        // Disable area select if no location is selected
        areaSelect.disabled = !selectedLocationId;
    }

    locationSelect.addEventListener('change', filterAreas);

    // Initialize area filtering
    filterAreas();

    // Form validation
    const form = document.querySelector('form');
    form.addEventListener('submit', function(e) {
        let rackSize = sizeUnitsSelect.value;

        if (rackSize === 'custom') {
            rackSize = customUsizeInput.value;
            if (!rackSize || rackSize < 1 || rackSize > 100) {
                e.preventDefault();
                alert('Please enter a valid custom rack size (1-100 units).');
                customUsizeInput.focus();
                return false;
            }
            // Set the actual value for submission
            sizeUnitsSelect.innerHTML += `<option value="${rackSize}" selected></option>`;
        }

        if (!locationSelect.value) {
            e.preventDefault();
            alert('Please select a location for the rack.');
            locationSelect.focus();
            return false;
        }

        {% if mode == 'edit' %}
        // Warn about size changes if rack has items
        const originalSize = {{ rack.size_units|default(0) }};
        const newSize = parseInt(rackSize);
        const hasItems = {{ rack.items|length }};

        if (hasItems > 0 && originalSize !== newSize) {
            const confirmed = confirm(
                'Warning: This rack currently has items installed. Changing the rack size may affect item positions and cause issues with the rack layout.\n\n' +
                'Are you sure you want to proceed?'
            );
            if (!confirmed) {
                e.preventDefault();
                return false;
            }
        }
        {% endif %}
    });

    {% if mode == 'edit' %}
    // Location change warning
    const originalLocationId = '{{ rack.location_id|default("") }}';
    locationSelect.addEventListener('change', function() {
        const newLocationId = this.value;
        const hasItems = {{ rack.items|length }};

        if (hasItems > 0 && originalLocationId && originalLocationId !== newLocationId) {
            const warningDiv = document.getElementById('locationWarning');
            if (warningDiv) {
                warningDiv.remove();
            }

            if (newLocationId !== originalLocationId) {
                const warning = document.createElement('div');
                warning.id = 'locationWarning';
                warning.className = 'alert alert-warning mt-2';
                warning.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i><strong>Location Change:</strong> Moving this rack will affect the physical location of all {{ rack.items|length }} installed items.';
                this.parentNode.appendChild(warning);
            }
        }
    });
    {% endif %}
});
</script>
{% endif %}
{% endblock %}